{
  "memory_gate": {
    "enabled": true,
    "min_available_gib": 3.0,
    "swap_weight": 0.0
  },
  "role_card": {
    "t3_state_db": "~/.t3/userdata/statev2.sqlite",
    "skill_path": "~/.claude/skills/orchestrator/SKILL.md"
  },
  "watcher": {
    "enabled": true,
    "t3_home": "~/.t3",
    "orchestrator": "mcp:<orchestrator thread id>",
    "projects": [
      "~/src/web-shop"
    ],
    "timezone": "America/New_York",
    "rate_limit_minutes": 60,
    "quiet_hours": null,
    "wake": {
      "webhooks": {}
    },
    "jobs": {
      "command": [
        "ssh",
        "cluster-login",
        "bash -lc 'bjobs -a -o \"jobid stat\" -noheader'"
      ],
      "done_states": [
        "DONE"
      ],
      "failed_states": [
        "EXIT"
      ],
      "lookup_command": "ssh cluster-login \"bash -l -s -- {jobs}\" < ~/src/orchestack/watcher/lsf_job_states.sh",
      "globs": ["~/code/*/.work/orchestrator/jobs"]
    },
    "children": {
      "stuck_hours": 3,
      "approval_minutes": 10
    },
    "disk": {
      "paths": [
        "/"
      ],
      "min_free_gb": 20
    },
    "usage": {
      "command": "python3 ~/tools/usage_meter.py",
      "weekly_reset": "Mon 09:00",
      "pace_per_day": 15,
      "behind_by": 20
    },
    "decision": {
      "minutes": 30
    },
    "expiry": {
      "enabled": false,
      "name": "tsh",
      "command": [
        "tsh",
        "status"
      ],
      "pattern": "Valid until:\\s+(\\S+ \\S+ [+-]\\d{4})",
      "warn_minutes": 60,
      "only_with_jobs": true,
      "hint": "Run tsh login."
    },
    "hosts": []
  }
}
